# Пример настроек сервера ProStyle. Настоящий файл — /opt/prostyle/.env (права 600, владелец root).
# Значения — без пробелов и спецсимволов ($ & \ ' "): файл читают и systemd, и shell-скрипты.

# --- Приложение ---
NODE_ENV=production
PORT=3010
HOSTNAME=127.0.0.1
SITE_URL=https://prostyle.agency
# Секрет для подписи ссылок (отмена заказа и т. п.): длинная случайная строка
SESSION_SECRET=
# Вложения чата заявок
UPLOAD_DIR=/var/lib/prostyle/uploads

# --- База MySQL 8 ---
# mysql://пользователь:пароль@127.0.0.1:3306/prostyle
DATABASE_URL=

# --- Почта: локальный Postfix + OpenDKIM ---
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_FROM=ProStyle <noreply@prostyle.agency>
MAIL_REPLY_TO=
# Кому уведомления менеджеру; копия всех писем
MAIL_TO=
MAIL_COPY=

# --- Склад Oasis (api.oasiscatalog.com/v4) ---
OASIS_API_KEY=
OASIS_USER_ID=
# Токен служебных вызовов синхронизации (таймеры, деплой): длинная случайная строка
OASIS_SYNC_TOKEN=

# --- Склад gifts.ru (api2.gifts.ru/export/v2), IP сервера — в белом списке кабинета ---
GIFTS_LOGIN=
GIFTS_PASSWORD=

# --- ИИ-менеджер Виктория (RouterAI, OpenAI-совместимый API) ---
ROUTERAI_API_KEY=
ROUTERAI_MODEL=openai/gpt-6-luna
# ROUTERAI_BASE_URL=https://routerai.ru/api/v1
