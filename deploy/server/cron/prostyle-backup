#!/bin/sh
# Ежедневный бэкап базы и вложений чата ProStyle, хранится 14 дней.
set -e
D=/var/backups/prostyle; T=$(date +%F)
mysqldump --single-transaction --routines prostyle | gzip > "$D/db-$T.sql.gz"
tar -czf "$D/uploads-$T.tar.gz" -C /var/lib/prostyle uploads
find "$D" -type f -mtime +14 -delete
